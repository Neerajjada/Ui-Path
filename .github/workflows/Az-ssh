name: Copy Files to Windows VM via SSH

on:
  push:
    branches:
      - main
  workflow_dispatch:

jobs:
  deploy:
    runs-on: windows-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up SSH Key
        run: |
          # Create the .ssh directory if it doesn't exist
          $sshDir = "$HOME\.ssh"
          if (-not (Test-Path $sshDir)) {
              New-Item -ItemType Directory -Path $sshDir -Force | Out-Null
          }
          
          # Write the private key from secrets to a file
          $env:VM_SSH_KEY | Out-File -Encoding ascii -NoNewline "$sshDir\id_rsa"
          
          # Set correct permissions for OpenSSH (Windows equivalent of chmod 600)
          icacls "$sshDir\id_rsa" /inheritance:r
          icacls "$sshDir\id_rsa" /grant:r "$($env:USERNAME):R"
        env:
          VM_SSH_KEY: ${{ secrets.VM_SSH_KEY }}

      - name: Execute Backup and File Transfer via SSH/SCP
        shell: powershell
        env:
          VM_HOST: ${{ secrets.VM_HOST }}
          VM_USERNAME: ${{ secrets.VM_USERNAME }}
          VM_PORT: ${{ secrets.VM_PORT | default('22') }}
        run: |
          $Server =$env:VM_HOST
          $Username =$env:VM_USERNAME
          $Port =$env:VM_PORT
          $SourcePath = "${{ github.workspace }}\python\new.txt"
          $DestinationFolder = "C:\pythonfiles"

          # 1. Run remote PowerShell script via SSH to backup existing file & ensure directory exists
          Write-Host "Connecting to $Server:$Port via SSH for backup..."
          
          $RemoteScript = @"
          $Dest = '$DestinationFolder'
          if (-not (Test-Path -Path $Dest)) {
              New-Item -ItemType Directory -Path $Dest -Force | Out-Null
          }
          $TargetFile = Join-Path -Path$Dest -ChildPath 'new.txt'
          if (Test-Path -Path $TargetFile) {
              `$Timestamp = (Get-Date).ToString('dd-MMM-yyyy_HH-mm-ss')
              `$BackupFileName = "backup_`$Timestamp`_new.txt"
              `$BackupPath = Join-Path -Path `$Dest -ChildPath `$BackupFileName
              
              `$Counter = 1
              while (Test-Path -Path `$BackupPath) {
                  `$BackupFileName = "backup_`$Timestamp`_(`$Counter)_new.txt"
                  `$BackupPath = Join-Path -Path `$Dest -ChildPath `$BackupFileName
                  `$Counter++
              }
              Write-Host "Backing up existing file to `$BackupFileName..."
              Copy-Item -Path `$TargetFile -Destination `$BackupPath -Force
          }
          "@

          # Execute remote script over SSH
          ssh -o StrictHostKeyChecking=no -p $Port "${Username}@${Server}" "powershell -Command `"$RemoteScript`""

          if ($LASTEXITCODE -ne 0) {
              Write-Error "Remote backup step failed."
              exit $LASTEXITCODE
          }

          # 2. Copy the latest file from runner to remote VM using scp
          Write-Host "Copying latest file to $Server:$DestinationFolder..."
          scp -o StrictHostKeyChecking=no -P $Port "$SourcePath" "${Username}@${Server}:$DestinationFolder\"

          if ($LASTEXITCODE -ne 0) {
              Write-Error "SCP file transfer failed."
              exit $LASTEXITCODE
          }

          Write-Host "Deployment completed successfully!"
